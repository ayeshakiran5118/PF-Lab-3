#include <iostream>
using namespace std;

int main() {
    int units;
    float mass;
    double weight;

    units = 10;
    mass = 5.5;
    weight = mass * units;

    cout << "Units = " << units << endl;
    cout << "Mass = " << mass << endl;
    cout << "Weight = " << weight << endl;

    return 0;
}
